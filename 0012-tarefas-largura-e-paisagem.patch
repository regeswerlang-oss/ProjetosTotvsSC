+// ============================================================================
+//  ABA TAREFAS — todos os tickets do cliente, recortados por tag
+// ============================================================================
+// Cópia da aba GAPs, por decisão explícita (25/08/2026): a GAPs é a tela onde se
+// decide escopo com o cliente e não pode regredir por um ajuste feito aqui. O
+// preço está assumido — melhoria numa não chega sozinha na outra.
+//
+// Três diferenças de comportamento em relação à GAPs:
+//   1. entra TODO ticket do cliente, não só o marcado com a tag GAP;
+//   2. a tag `GAP` APARECE na lista e no filtro — aqui ela é uma tag como
+//      qualquer outra, e é o que permite separar "o que já virou GAP" do resto;
+//   3. o filtro de tags é OU por padrão, com botão para E. Numa tela de garimpo
+//      o normal é juntar assuntos ("INTEGRACAO ou PRIORIDADE"); cruzar é a
+//      exceção. Na GAPs continua sendo só E.
+const tar = {
+  customer: null, itens: [], modo: 'lista',
+  tags: new Set(), tagModo: 'ou',            // ou | e
+  ord: { col: 'time_estimate', dir: -1 },
+};
+
+const TAR_COLS = {
+  id: { rot: 'Task', val: t => t.id || '' },
+  titulo: { rot: 'Título', val: t => t.titulo || '' },
+  etapa_gap: { rot: 'Etapa', val: t => t.etapa_gap || '' },
+  status_tasks: { rot: 'Status', val: t => t.status_tasks || '' },
+  produto: { rot: 'Produto', val: t => t.produto || '' },
+  tags: { rot: 'Tags', val: t => (t.tags || []).join(', ') },
+  time_estimate: { rot: 'Horas', val: t => Number(t.time_estimate || 0), num: true },
+  responsavel_nome: { rot: 'Responsável', val: t => (t.responsavel_nome || t.user_assigned || '').trim() },
+  observador: { rot: 'Observadores', val: t => t.observador || '' },
+  decisao: { rot: 'Decisão', val: t => DECISAO[t.decisao]?.label || '' },
+};
+
+async function initTarefas() {
+  const cli = state.selected?.cli;
+  $('#tar-cliente-nome').textContent =
+    (state.selected?.projeto?.nome_cliente_projeto || '').trim() || cli || '—';
+  if (tar.customer === cli) return;
+  tar.customer = cli;
+  if (!cli) { $('#tar-conteudo').innerHTML = blocoVazioCad('Abra um projeto para ver as tarefas do cliente.'); return; }
+  $('#tar-conteudo').innerHTML = '<div class="text-slate-400 text-sm py-6 text-center">Carregando tarefas…</div>';
+  try {
+    const j = await api(`/api/tarefas/${encodeURIComponent(cli)}`);
+    tar.itens = j.tarefas || [];
+  } catch (e) {
+    tar.customer = null;
+    $('#tar-conteudo').innerHTML = blocoErro('Não foi possível carregar as tarefas', e, initTarefas);
+    return;
+  }
+  const etapas = [...new Set(tar.itens.map(t => t.etapa_gap).filter(Boolean))].sort();
+  $('#tar-etapa').innerHTML = '<option value="">Todas as etapas</option>' +
+    etapas.map(e => `<option value="${escapeHtml(e)}">${escapeHtml(e)}</option>`).join('');
+
+  const resps = [...new Set(tar.itens
+    .map(t => (t.responsavel_nome || t.user_assigned || '').trim()).filter(Boolean))]
+    .sort((a, b) => a.localeCompare(b, 'pt-BR'));
+  $('#tar-resp').innerHTML = '<option value="">Todo responsável</option>' +
+    resps.map(r => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
+
+  pintaTagsTarefas();
+  renderTarefas();
+}
+
+/** Tags por frequência: as que realmente cortam a lista vêm primeiro. */
+function pintaTagsTarefas() {
+  const cont = new Map();
+  tar.itens.forEach(t => (t.tags || []).forEach(x => cont.set(x, (cont.get(x) || 0) + 1)));
+  tar.tags.forEach(x => { if (!cont.has(x)) tar.tags.delete(x); });   // sumiu do cliente
+  $('#tar-tags-lista').innerHTML = [...cont.entries()]
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'pt-BR'))
+    .map(([x, n]) => `
+      <label class="flex items-center gap-2 px-1 py-0.5 hover:bg-slate-50 rounded cursor-pointer text-sm">
+        <input type="checkbox" value="${escapeHtml(x)}" ${tar.tags.has(x) ? 'checked' : ''} class="accent-totvs-blue">
+        <span class="flex-1 truncate font-mono text-xs">${escapeHtml(x)}</span>
+        <span class="text-xs text-slate-400">${n}</span>
+      </label>`).join('') || '<p class="text-xs text-slate-400 px-1">Nenhuma tag neste cliente.</p>';
+  $('#tar-tags-lista').querySelectorAll('input').forEach(c =>
+    c.addEventListener('change', () => {
+      if (c.checked) tar.tags.add(c.value); else tar.tags.delete(c.value);
+      renderTarefas();
+    }));
+}
+
+function tarefasFiltradas() {
+  const q = semAcento($('#tar-busca').value.trim());
+  const etapa = $('#tar-etapa').value;
+  const dec = $('#tar-decisao').value;
+  const resp = $('#tar-resp').value;
+  return tar.itens.filter(t => {
+    if (etapa && t.etapa_gap !== etapa) return false;
+    if (dec === '_sem' && t.decisao) return false;
+    if (dec && dec !== '_sem' && t.decisao !== dec) return false;
+    if (resp && (t.responsavel_nome || t.user_assigned || '').trim() !== resp) return false;
+    if (tar.tags.size) {
+      const suas = new Set(t.tags || []);
+      if (tar.tagModo === 'e') {
+        for (const x of tar.tags) if (!suas.has(x)) return false;     // interseção
+      } else {
+        let algum = false;
+        for (const x of tar.tags) if (suas.has(x)) { algum = true; break; }
+        if (!algum) return false;                                     // união
+      }
+    }
+    if (q) {
+      const alvo = semAcento(`${t.id || ''} ${t.titulo || ''} ${t.produto || ''} ${t.competencia || ''} ${t.responsavel_nome || ''}`);
+      if (!alvo.includes(q)) return false;
+    }
+    return true;
+  });
+}
+
+function ordenaTarefas(itens) {
+  const c = TAR_COLS[tar.ord.col] || TAR_COLS.time_estimate;
+  const d = tar.ord.dir;
+  return itens.slice().sort((a, b) => {
+    const va = c.val(a), vb = c.val(b);
+    if (c.num) return (va - vb) * d;
+    if (!va && vb) return 1;                  // vazio sempre no fim
+    if (va && !vb) return -1;
+    return String(va).localeCompare(String(vb), 'pt-BR') * d;
+  });
+}
+
+function renderTarefas() {
+  const itens = ordenaTarefas(tarefasFiltradas());
+  const horas = itens.reduce((a, t) => a + Number(t.time_estimate || 0), 0);
+  const gaps = itens.filter(t => t.eh_gap).length;
+  const abertas = itens.filter(t => !['Resolvido', 'Cancelado'].includes(t.status_tasks || '')).length;
+
+  const kpi = (rot, val, sub, cls) => `
+    <div class="rounded-lg p-4 ${cls}">
+      <p class="text-xs opacity-80">${rot}</p>
+      <p class="text-2xl font-totvs mt-1">${val}</p>
+      <p class="text-xs opacity-80 mt-0.5">${sub}</p>
+    </div>`;
+  $('#tar-kpis').innerHTML =
+    kpi('Tarefas', String(itens.length),
+        itens.length === tar.itens.length ? 'do cliente' : `de ${tar.itens.length} no total`,
+        'bg-totvs-petroleo text-white') +
+    kpi('Horas estimadas', fmtNum(horas), 'soma das estimativas', 'bg-totvs-blue text-totvs-petroleo') +
+    kpi('Em aberto', String(abertas), `${itens.length - abertas} resolvida(s)/cancelada(s)`, 'bg-totvs-purple text-white') +
+    kpi('Marcadas como GAP', String(gaps), `${itens.length - gaps} sem a tag`, 'bg-white border border-slate-200 text-totvs-petroleo');
+
+  $('#tar-tags-n').textContent = tar.tags.size ? `(${tar.tags.size} ${tar.tagModo.toUpperCase()})` : '';
+  $('#tar-conteudo').innerHTML = itens.length === 0
+    ? blocoVazioCad('Nenhuma tarefa para este filtro.')
+    : (tar.modo === 'kanban' ? kanbanTarefas(itens) : listaTarefas(itens));
+}
+
+function thTar(col, extra = '') {
+  const c = TAR_COLS[col];
+  const on = tar.ord.col === col;
+  const seta = on ? (tar.ord.dir === 1 ? '▲' : '▼') : '<span class="opacity-0 group-hover:opacity-40">▲</span>';
+  return `<th class="p-3 ${extra} cursor-pointer select-none group hover:text-totvs-petroleo"
+              data-ord="${col}" title="Ordenar por ${c.rot}">
+    ${c.rot} <span class="text-[10px] ${on ? 'text-totvs-blue' : ''}">${seta}</span></th>`;
+}
+
+function listaTarefas(itens) {
+  return `
+    <div class="bg-white rounded-lg border border-slate-200 overflow-x-auto">
