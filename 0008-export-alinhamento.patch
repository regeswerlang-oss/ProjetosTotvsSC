+// Gmail não faz flex nem grid. Uma "fileira" (grid de várias colunas ou flex em
+// linha, com 2+ filhos) precisa virar <table> — senão os KPIs empilham em quatro
+// cartões gigantes e a lista de tabelas monitoradas desmonta.
+//
+// ARMADILHA que isso resolve: converter CADA fileira na sua própria <table> não
+// basta. Tabelas independentes calculam colunas independentes, então dez linhas
+// de uma lista saíam cada uma com uma largura de coluna — que é o desalinhamento
+// do rascunho do Gmail em 25/08/2026. Fileiras IRMÃS e de mesma forma têm que
+// entrar na MESMA tabela, uma <tr> cada.
+function colunasDaLinha(el, cs) {
+  const vis = [...el.children].filter(f => getComputedStyle(f).display !== 'none');
+  if (vis.length < 2) return 0;
+  const d = cs.display || '';
+  if (d.includes('grid') && (cs.gridTemplateColumns || '').split(/\s+/).filter(Boolean).length > 1) return vis.length;
+  if (d.includes('flex') && !(cs.flexDirection || '').startsWith('column')) return vis.length;
+  return 0;
+}
+
+function snapLinhas(corrida, opt) {
+  const trs = corrida.map(({ no, cs }) => {
+    const larg = no.getBoundingClientRect().width || 0;
+    const tds = [...no.children].map(f => {
+      const fcs = getComputedStyle(f);
+      if (fcs.display === 'none') return '';
+      const est = ['vertical-align:top'];
+      // o gap do flex não existe em tabela; sem isso as colunas se encostam.
+      // Na última célula não: mexeria na borda direita da linha.
+      if (f !== no.lastElementChild) est.push('padding-right:8px');
+      const w = parseFloat(fcs.width) || 0;
+      if (w > 0 && larg > 0) est.push(`width:${(100 * w / larg).toFixed(2)}%`);
+      // justify-between e ml-auto empurram para a direita no flex; em tabela
+      // quem faz isso é o text-align, senão o número volta a encostar à esquerda
+      if (fcs.textAlign === 'right' || fcs.marginLeft === 'auto' ||
+          (cs.justifyContent || '').includes('space-between') && f === no.lastElementChild) {
+        est.push('text-align:right');
+      }
+      return `<td style="${est.join(';')}">${snapNo(f, cs, opt)}</td>`;
+    }).join('');
+    if (!tds) return '';
+    const linha = [];
+    if (!ehVazio(cs.backgroundColor)) linha.push(`background-color:${cs.backgroundColor}`);
+    if (!ehVazio(cs.borderTop)) linha.push(`border-top:${cs.borderTop}`);
+    if (!ehVazio(cs.paddingTop)) linha.push(`padding-top:${cs.paddingTop}`);
+    return `<tr style="${linha.join(';')}">${tds}</tr>`;
+  }).join('');
+  // table-layout:fixed faz a PRIMEIRA linha ditar as colunas — é o que garante
+  // que as dez linhas fiquem na mesma grade.
+  return trs ? `<table style="width:100%;border-collapse:collapse;table-layout:fixed">${trs}</table>` : '';
+}
+
+/** Percorre os filhos agrupando fileiras irmãs de mesma forma numa tabela só. */
+function snapFilhos(pai, csPai, opt) {
+  let out = '', corrida = [], espaco = '';
+  const descarrega = () => { if (corrida.length) { out += snapLinhas(corrida, opt); corrida = []; } };
+  for (const f of pai.childNodes) {
+    // Espaço em branco entre duas linhas irmãs (as quebras do template literal)
+    // não pode encerrar a corrida — era o que separava o cabeçalho da matriz das
+    // linhas de dados, cada um na sua tabela e com colunas próprias. Mas também
+    // não pode ser jogado fora sem olhar: entre um rótulo e um valor ele é o
+    // espaço da frase ("Horas do projeto 4214"). Então fica retido e só é
+    // descartado se a corrida realmente continuar.
+    if (f.nodeType === 3 && !f.nodeValue.trim()) { espaco += f.nodeValue; continue; }
+    if (f.nodeType === 1) {
+      const cs = getComputedStyle(f);
+      const n = (cs.display === 'none' || cs.visibility === 'hidden') ? 0 : colunasDaLinha(f, cs);
+      if (n) {
+        // muda o número de colunas ⇒ é outra lista, abre tabela nova
+        if (corrida.length && corrida[0].n !== n) descarrega();
+        espaco = '';
+        corrida.push({ no: f, cs, n });
+        continue;
+      }
+    }
+    descarrega();
+    out += espaco + snapNo(f, csPai, opt);
+    espaco = '';
+  }
+  descarrega();
+  return out + espaco;
+}
+
 function snapNo(no, pai, opt) {
   if (no.nodeType === 3) return escapeHtml(no.nodeValue);
   if (no.nodeType !== 1) return '';
@@ -3133,22 +3215,6 @@ function snapNo(no, pai, opt) {
   if (cs.display === 'none' || cs.visibility === 'hidden') return '';
   if (['INPUT', 'SELECT', 'TEXTAREA'].includes(tag)) return snapCampo(no);
 
