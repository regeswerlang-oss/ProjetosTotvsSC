   const horas = itens.reduce((a, g) => a + Number(g.time_estimate || 0), 0);
   const decididos = itens.filter(g => g.decisao && g.decisao !== 'pendente').length;
   const aprovados = itens.filter(g => g.decisao === 'aprovar').length;
@@ -1688,6 +1752,7 @@ function renderGaps() {
     kpi('Decididos', `${decididos}/${itens.length}`, `${aprovados} aprovado(s)`, 'bg-totvs-purple text-white') +
     kpi('Sem decisão', String(itens.filter(g => !g.decisao).length), 'aguardando reunião', 'bg-white border border-slate-200 text-totvs-petroleo');
 
+  $('#gap-tags-n').textContent = gap.tags.size ? `(${gap.tags.size})` : '';
   $('#gap-conteudo').innerHTML = itens.length === 0
     ? blocoVazioCad('Nenhum GAP para este filtro.')
     : (gap.modo === 'kanban' ? kanbanGaps(itens) : listaGaps(itens));
@@ -1699,15 +1764,45 @@ function selosGap(g) {
     ${g.tem_alinhamento ? '<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600" title="Tem alinhamento comercial">◆</span>' : ''}`;
 }
 
+function ordenaGaps(itens) {
+  const c = GAP_COLS[gap.ord.col] || GAP_COLS.time_estimate;
+  const d = gap.ord.dir;
+  return itens.slice().sort((a, b) => {
+    const va = c.val(a), vb = c.val(b);
+    if (c.num) return (va - vb) * d;
+    // vazio sempre no fim, independentemente da direção
+    if (!va && vb) return 1;
+    if (va && !vb) return -1;
+    return String(va).localeCompare(String(vb), 'pt-BR') * d;
+  });
+}
+
+function thGap(col, extra = '') {
+  const c = GAP_COLS[col];
+  const on = gap.ord.col === col;
+  const seta = on ? (gap.ord.dir === 1 ? '▲' : '▼') : '<span class="opacity-0 group-hover:opacity-40">▲</span>';
+  return `<th class="p-3 ${extra} cursor-pointer select-none group hover:text-totvs-petroleo"
+              data-ord="${col}" title="Ordenar por ${c.rot}">
+    ${c.rot} <span class="text-[10px] ${on ? 'text-totvs-blue' : ''}">${seta}</span></th>`;
+}
+
+function chipsTags(tags, max = 3) {
+  const t = tags || [];
+  if (!t.length) return '<span class="text-xs text-slate-300">—</span>';
+  const mostra = t.slice(0, max).map(x =>
+    `<span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[11px] font-mono">${escapeHtml(x)}</span>`).join(' ');
+  return mostra + (t.length > max
+    ? ` <span class="text-[11px] text-slate-400" title="${escapeHtml(t.join(', '))}">+${t.length - max}</span>` : '');
+}
+
 function listaGaps(itens) {
   return `
     <div class="bg-white rounded-lg border border-slate-200 overflow-x-auto">
