+      ? { col, dir: -gap.ord.dir }
+      : { col, dir: GAP_COLS[col]?.num ? -1 : 1 };
+    renderGaps();
+    return;
+  }
   const linha = e.target.closest('[data-gap]');
   if (linha) abreGap(linha.dataset.gap);
 });
