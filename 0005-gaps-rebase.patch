 $('#gap-reload').addEventListener('click', () => { gap.customer = null; initGaps(); });
 $('#tab-gaps').addEventListener('click', e => {
+  const th = e.target.closest('[data-ord]');
+  if (th) {
+    const col = th.dataset.ord;
+    // mesma coluna inverte; coluna nova começa desc em número, asc em texto
