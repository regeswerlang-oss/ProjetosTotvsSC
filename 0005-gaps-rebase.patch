+      for (const t of gap.tags) if (!suas.has(t)) return false;
+    }
     if (q) {
       const alvo = semAcento(`${g.id || ''} ${g.titulo || ''} ${g.produto || ''} ${g.competencia || ''} ${g.responsavel_nome || ''}`);
       if (!alvo.includes(q)) return false;
@@ -1671,7 +1735,7 @@ function gapsFiltrados() {
 }
 
 function renderGaps() {
