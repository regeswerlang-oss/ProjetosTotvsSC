     if (dec === '_sem' && g.decisao) return false;
     if (dec && dec !== '_sem' && g.decisao !== dec) return false;
+    if (resp && (g.responsavel_nome || g.user_assigned || '').trim() !== resp) return false;
+    // E, não OU: o ticket precisa ter TODAS as tags marcadas
