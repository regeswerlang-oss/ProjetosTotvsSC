-          <th class="p-3">Status</th><th class="p-3">Produto</th>
-          <th class="p-3 text-right">Horas</th><th class="p-3">Responsável</th>
-          <th class="p-3">Decisão</th>
+          ${thGap('id')}${thGap('titulo')}${thGap('etapa_gap')}${thGap('status_tasks')}
+          ${thGap('produto')}${thGap('tags')}${thGap('time_estimate', 'text-right')}
+          ${thGap('responsavel_nome')}${thGap('observador')}${thGap('decisao')}
         </tr></thead>
         <tbody>${itens.map(g => `
           <tr data-gap="${g.uuid_ticket}" class="border-b border-slate-100 last:border-0 hover:bg-slate-50 cursor-pointer">
@@ -1716,8 +1811,10 @@ function listaGaps(itens) {
             <td class="p-3 text-xs">${escapeHtml(g.etapa_gap || '—')}</td>
             <td class="p-3 text-xs">${escapeHtml(g.status_tasks || '—')}</td>
             <td class="p-3 text-xs text-slate-500">${escapeHtml(g.produto || '—')}</td>
+            <td class="p-3">${chipsTags(g.tags)}</td>
             <td class="p-3 text-right tabular-nums">${g.time_estimate ? fmtNum(g.time_estimate) : '—'}</td>
             <td class="p-3 text-xs">${escapeHtml((g.responsavel_nome || g.user_assigned || '—').trim())}</td>
+            <td class="p-3 text-xs text-slate-500">${escapeHtml(g.observador || '—')}</td>
             <td class="p-3">${selosGap(g) || '<span class="text-xs text-slate-400">—</span>'}</td>
           </tr>`).join('')}</tbody>
       </table>
@@ -1751,7 +1848,7 @@ function kanbanGaps(itens) {
             </div>
             <p class="text-sm font-medium mt-1 leading-snug">${escapeHtml(g.titulo || '—')}</p>
             <p class="text-xs text-slate-500 mt-1">${escapeHtml(g.etapa_gap || '—')}${g.produto ? ' · ' + escapeHtml(g.produto) : ''}</p>
-            <div class="mt-2 flex items-center gap-1">${selosGap(g)}</div>
