+  ord: { col: 'time_estimate', dir: -1 },
+};
+
+// Colunas ordenáveis da lista: rótulo + como extrair o valor de comparação
+const GAP_COLS = {
+  id: { rot: 'GAP', val: g => g.id || '' },
+  titulo: { rot: 'Título', val: g => g.titulo || '' },
+  etapa_gap: { rot: 'Etapa', val: g => g.etapa_gap || '' },
+  status_tasks: { rot: 'Status', val: g => g.status_tasks || '' },
+  produto: { rot: 'Produto', val: g => g.produto || '' },
+  tags: { rot: 'Tags', val: g => (g.tags || []).join(', ') },
+  time_estimate: { rot: 'Horas', val: g => Number(g.time_estimate || 0), num: true },
+  responsavel_nome: { rot: 'Responsável', val: g => (g.responsavel_nome || g.user_assigned || '').trim() },
+  observador: { rot: 'Observadores', val: g => g.observador || '' },
+  decisao: { rot: 'Decisão', val: g => DECISAO[g.decisao]?.label || '' },
+};
 
 // Ordem do Kanban = fluxo real do atendimento, não ordem alfabética
 const GAP_STATUS = ['Novo', 'Aberto', 'Em Andamento', 'Agendado', 'Em Espera',
@@ -1648,6 +1681,30 @@ async function initGaps() {
   const etapas = [...new Set(gap.itens.map(g => g.etapa_gap).filter(Boolean))].sort();
   $('#gap-etapa').innerHTML = '<option value="">Todas as etapas</option>' +
     etapas.map(e => `<option value="${escapeHtml(e)}">${escapeHtml(e)}</option>`).join('');
+
+  const resps = [...new Set(gap.itens
+    .map(g => (g.responsavel_nome || g.user_assigned || '').trim()).filter(Boolean))]
+    .sort((a, b) => a.localeCompare(b, 'pt-BR'));
+  $('#gap-resp').innerHTML = '<option value="">Todo responsável</option>' +
+    resps.map(r => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
+
+  // Tags ordenadas por frequência: as que realmente cortam a lista vêm primeiro
+  const cont = new Map();
+  gap.itens.forEach(g => (g.tags || []).forEach(t => cont.set(t, (cont.get(t) || 0) + 1)));
+  gap.tags.forEach(t => { if (!cont.has(t)) gap.tags.delete(t); });   // sumiu do cliente
+  $('#gap-tags-lista').innerHTML = [...cont.entries()]
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'pt-BR'))
+    .map(([t, n]) => `
+      <label class="flex items-center gap-2 px-1 py-0.5 hover:bg-slate-50 rounded cursor-pointer text-sm">
+        <input type="checkbox" value="${escapeHtml(t)}" ${gap.tags.has(t) ? 'checked' : ''} class="accent-totvs-blue">
+        <span class="flex-1 truncate font-mono text-xs">${escapeHtml(t)}</span>
+        <span class="text-xs text-slate-400">${n}</span>
+      </label>`).join('') || '<p class="text-xs text-slate-400 px-1">Sem tags além de GAP.</p>';
+  $('#gap-tags-lista').querySelectorAll('input').forEach(c =>
+    c.addEventListener('change', () => {
+      if (c.checked) gap.tags.add(c.value); else gap.tags.delete(c.value);
+      renderGaps();
+    }));
   renderGaps();
 }
 
